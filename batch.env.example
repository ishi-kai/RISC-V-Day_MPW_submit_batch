# Copy to batch.env (chmod 600) and fill in.  Read by run_batch.sh.

# Form responses via the Sheets API (service account, see README.md)
SHEET_ID=""
CREDENTIALS="$HOME/.config/inv-form-sa.json"
# SHEET_RANGE="'フォームの回答 1'!A1:Z"   # only if the responses are not on the first sheet

# ... or a responses CSV that something else keeps up to date
# RESPONSES_CSV="/path/to/responses.csv"

# GitHub token (optional, raises the API limit from 60 to 5000 requests / hour)
# GITHUB_TOKEN="github_pat_..."

# DRC / LVS threads (default: all CPUs)
# THREADS=8

# Publishing the results (GDS / layout image / reports) to GitHub over SSH
PUBLISH_REPO="git@github.com:ishi-kai/RISC-V-Day_2611_inverter_workshop.git"
# PUBLISH_BRANCH="main"
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_KEY_PASSPHRASE=""        # passphrase of SSH_KEY
# PUBLISH_GIT_NAME="submit_inverter"        # commit author
# PUBLISH_GIT_EMAIL="you@example.com"
